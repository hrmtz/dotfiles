# Kali Linux specific zsh config

##### PATH 関連 #####
# 基本的な PATH のみ（Homebrew なし）
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

##### Python / 開発ツール #####
# Kali に標準搭載の python3
if command -v python3 >/dev/null 2>&1; then
  alias python="python3"
fi

# Kali のセキュリティツール（自動検出）
for tool in nmap sqlmap nikto gobuster hydra; do
  if command -v "$tool" >/dev/null 2>&1; then
    # 存在確認済み、特別な alias は不要
    true
  fi
done

# Pentest 学習環境用：SSH キーパス（必要に応じて設定）
# export SSH_KEY_PATH="$HOME/.ssh/id_rsa"

# Kali はシンプルに。macOS の Homebrew/言語ランタイムは不要

##### Docker 環境サポート #####
if [ -f /.dockerenv ] || grep -q 'docker\|containerd' /proc/1/cgroup 2>/dev/null; then
  # svc コマンド（systemctl 代替）
  if [ -f "$HOME/.zsh/docker-svc.zsh" ]; then
    source "$HOME/.zsh/docker-svc.zsh"
  fi

  # systemctl のフォールバック（エラーメッセージを分かりやすく）
  systemctl() {
    echo "systemctl is not available in Docker. Use 'svc' instead:" >&2
    echo "  svc start <service>    svc stop <service>" >&2
    echo "  svc status <service>   svc list" >&2
    return 1
  }
fi
